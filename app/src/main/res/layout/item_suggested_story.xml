<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgStoryThumb"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_rounded_card_white"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvStoryLevelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_level_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="A1"
            android:textColor="@color/primary_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imgStoryThumb"
            app:layout_constraintTop_toTopOf="@id/imgStoryThumb" />

        <TextView
            android:id="@+id/tvStoryMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="• 3 phút đọc • Đời sống"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tvStoryLevelBadge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvStoryLevelBadge"
            app:layout_constraintTop_toTopOf="@id/tvStoryLevelBadge" />

        <TextView
            android:id="@+id/tvStoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="The Secret in the Attic"
            android:textColor="@color/text_title"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvStoryLevelBadge"
            app:layout_constraintTop_toBottomOf="@id/tvStoryLevelBadge" />

        <TextView
            android:id="@+id/tvStoryDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Mia tìm thấy chiếc hộp gỗ cũ của bà..."
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvStoryLevelBadge"
            app:layout_constraintTop_toBottomOf="@id/tvStoryTitle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvStoryLevelBadge"
            app:layout_constraintTop_toBottomOf="@id/tvStoryDesc">

            <TextView
                android:id="@+id/tvVocabCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="文A +6 từ vựng cơ bản"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReadSample"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#EFF6FF"
                android:paddingHorizontal="14dp"
                android:text="▶ Đọc thử"
                android:textAllCaps="false"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>