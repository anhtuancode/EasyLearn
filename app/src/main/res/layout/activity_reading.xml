<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- THANH TOP TOOLBAR TINH GỌN -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutReaderHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Nút quay lại (thay thế cho dấu X) -->
        <ImageButton
            android:id="@+id/btnBackReader"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:src="@drawable/ic_custom_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#1E293B" />

        <!-- Cụm Logo nhỏ và chữ EasyLearn -->
        <LinearLayout
            android:id="@+id/layoutBrandHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBackReader"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="EasyLearn"
                android:textColor="#0E1B38"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nút loa phát âm / đọc toàn bài truyện -->
        <ImageButton
            android:id="@+id/btnAudio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="#FFEDD5"
            android:contentDescription="Đọc truyện"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#EA580C" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- PHẦN NỘI DUNG CUỘN ĐỌC TRUYỆN -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewReading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomAction"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Card Thumbnail Bìa truyện -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#1D61F2">

                    <ImageView
                        android:id="@+id/imgStoryCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:src="@drawable/logo" />

                    <!-- Badge nổi trên ảnh bìa -->
                    <TextView
                        android:id="@+id/tvStoryBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_rounded_card_white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="📖 Đời sống • 3 min read"
                        android:textColor="#0E1B38"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chapter Tag -->
            <TextView
                android:id="@+id/tvChapterTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.08"
                android:text="CHAPTER 1 • MIDNIGHT ENCOUNTER"
                android:textColor="#2563EB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Tiêu đề truyện -->
            <TextView
                android:id="@+id/tvStoryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="The Secret in the Attic"
                android:textColor="#0E1B38"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- VĂN BẢN TRUYỆN DUY NHẤT HỖ TRỢ TAP-TO-TRANSLATE -->
            <TextView
                android:id="@+id/tvStoryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="8dp"
                android:textColor="#1E293B"
                android:textSize="18sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Nút Hoàn thành bài đọc cố định dưới đáy -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompleteReading"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/primary_blue"
            android:text="Hoàn thành bài đọc &amp; Ôn luyện  ➔"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>