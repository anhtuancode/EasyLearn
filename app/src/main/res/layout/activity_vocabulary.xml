<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- TOP HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutVocabHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgVocabLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Sổ từ vựng"
            android:textColor="#0E1B38"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgVocabLogo"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvVocabTotalBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="#EFF6FF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="0 từ"
            android:textColor="#1D61F2"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- KHU VỰC TÌM KIẾM & BỘ LỌC -->
    <LinearLayout
        android:id="@+id/layoutSearchAndFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutVocabHeader">

        <!-- Thanh tìm kiếm từ vựng -->
        <EditText
            android:id="@+id/edtSearchVocabulary"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_rounded_card_white"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="Tìm từ tiếng Anh hoặc nghĩa tiếng Việt..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="#0E1B38"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <!-- 3 Chip lọc trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipFilterAll"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#1D61F2"
                android:text="Tất cả"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipFilterLearning"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#EFF6FF"
                android:text="Chưa thuộc"
                android:textAllCaps="false"
                android:textColor="#1D61F2"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipFilterMastered"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#EFF6FF"
                android:text="Đã thuộc"
                android:textAllCaps="false"
                android:textColor="#1D61F2"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="19dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- DANH SÁCH TỪ VỰNG -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVocabularyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationVocab"
        app:layout_constraintTop_toBottomOf="@id/layoutSearchAndFilter" />

    <!-- TRẠNG THÁI TRỐNG KHI CHƯA CÓ TỪ -->
    <LinearLayout
        android:id="@+id/layoutEmptyVocabulary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationVocab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSearchAndFilter">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚"
            android:textSize="42sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Chưa có từ vựng nào"
            android:textColor="#0E1B38"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Hãy mở một truyện ngắn và chạm vào từ bất kỳ để lưu vào sổ tay nhé!"
            android:textColor="#64748B"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- THANH ĐIỀU HƯỚNG DƯỚI ĐÁY ĐỒNG BỘ 100% -->
    <LinearLayout
        android:id="@+id/bottomNavigationVocab"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_custom_bolt"
                app:tint="@color/text_sub" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Trang chủ"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabStories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_custom_info"
                app:tint="@color/text_sub" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Truyện ngắn"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab Sổ từ (Đang chọn -> Sáng xanh primary_blue) -->
        <LinearLayout
            android:id="@+id/tabVocabulary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_custom_check"
                app:tint="@color/primary_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Sổ từ"
                android:textColor="@color/primary_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_custom_person"
                app:tint="@color/text_sub" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cá nhân"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>